{
  "manifest_version": 3,
  "name": "ScamLens",
  "version": "2.5.0",
  "description": "One-click scam check for the page you're on, text you select, or a link you paste.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "contextMenus",
    "identity",
    "scripting",
    "storage"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Scan with ScamLens",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "host_permissions": [
    "https://scamlens-76sd.onrender.com/*"
  ],
  "key": ""
}